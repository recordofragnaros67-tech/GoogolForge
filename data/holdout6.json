0-12:10'], ['10:55-11:30', '10:00-10:20'], [], ['08:35-09:50', '10:55-12:25', '12:50-13:25']], '09:15', '12:55', 15]","None"],["[[['09:35-11:55', '08:55-11:20'], ['08:00-08:10'], ['08:15-09:10', '08:10-09:15'], ['08:05-08:25']], '08:05', '09:15', 30]","None"],["[[['06:55-07:00'], ['07:45-09:25', '07:25-09:25'], ['10:05-10:15', '07:35-08:15'], ['07:45-08:40', '06:20-08:40', '10:25-12:00', '07:40-10:00']], '06:05', '10:20', 15]","'06:05'"],["[[['10:25-12:45', '08:15-09:05', '08:55-09:10', '10:05-12:15'], ['08:20-09:15'], ['07:45-08:55', '10:35-10:55', '11:05-12:40', '08:00-08:50'], ['09:25-11:10', '08:15-09:40', '07:30-09:20']], '08:30', '11:05', 30]","None"],["[[[], [], ['15:05-16:50', '14:45-16:55', '13:35-14:50']], '09:40', '14:50', 90]","'09:40'"],["[[[], ['11:35-13:05']], '07:30', '15:20', 30]","'07:30'"],["[[['12:50-12:55', '08:25-10:35'], ['13:55-15:10', '15:55-16:05'], []], '09:15', '15:40', 30]","'10:35'"],["[[['13:45-14:15', '08:20-09:40'], ['09:40-11:55', '11:05-13:30', '11:00-12:20']], '08:20', '15:15', 15]","'13:30'"],["[[['06:55-08:05', '10:20-11:20', '05:40-07:30'], [], []], '06:20', '10:00', 30]","'08:05'"],["[[['12:10-13:20', '10:35-10:40'], ['10:55-11:25', '10:05-12:25'], ['11:10-11:45', '08:40-10:20', '08:00-10:25']], '08:20', '12:20', 60]","None"]],"ref":"def first_slot(busy: list, day_start: str, day_end: str, minutes: int):\n    def m(t):\n        h, mm = t.split(':')\n        return int(h) * 60 + int(mm)\n    spans = sorted((m(a), m(b)) for person in busy for s in person for a, b in [s.split('-')])\n    t, end = m(day_start), m(day_end)\n    for a, b in spans:\n        if a >= t + minutes:\n            break\n        if b > t:\n            t = b\n    if t + minutes <= end:\n        return '%02d:%02d' % divmod(t, 60)\n    return None\n"},{"id":"holdout/5","entry":"truth","prompt":"def truth(expr: str, env: dict) -> bool:\n    \"\"\"Evaluate a logic formula. Tokens: variable names (lowercase letters and digits, never a keyword),\n    the constants true and false, not, and, or, -> and parentheses. Tokens are separated by spaces,\n    except that parentheses may touch other tokens. Precedence from tightest to loosest:\n    not, and, or, ->. 'and' and 'or' group left to right; '->' (implication: false only when\n    the left side is true and the right side is false) groups RIGHT to left, so a -> b -> c\n    means a -> (b -> c). env maps every variable to True or False.\n    >>> truth('a -> b -> c', {'a': True, 'b': False, 'c': False})\n    True\n    >>> truth('not a or b and c', {'a': True, 'b': True, 'c': False})\n    False\n    \"\"\"\n","atol":0,"cases":[["['p', {'p': False, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","False"],["['p', {'p': False, 'q': True, 'rain': False, 'wet': True, 'x1': False}]","False"],["['true', {'p': True, 'q': False, 'rain': False, 'wet': True, 'x1': True}]","True"],["['true', {'p': True, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","True"],["['not false', {'p': True, 'q': False, 'rain': True, 'wet': True, 'x1': False}]","True"],["['not false', {'p': True, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","True"],["['p -> q', {'p': True, 'q': False, 'rain': False, 'wet': False, 'x1': True}]","False"],["['p -> q', {'p': False, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['p -> q -> rain', {'p': False, 'q': True, 'rain': False, 'wet': False, 'x1': True}]","True"],["['p -> q -> rain', {'p': False, 'q': False, 'rain': True, 'wet': True, 'x1': False}]","True"],["['(p -> q) -> rain', {'p': True, 'q': True, 'rain': False, 'wet': True, 'x1': False}]","False"],["['(p -> q) -> rain', {'p': True, 'q': False, 'rain': False, 'wet': True, 'x1': True}]","True"],["['not p or q and rain', {'p': False, 'q': False, 'rain': False, 'wet': False, 'x1': False}]","True"],["['not p or q and rain', {'p': True, 'q': False, 'rain': True, 'wet': False, 'x1': True}]","False"],["['not(p and q)', {'p': False, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['not(p and q)', {'p': True, 'q': False, 'rain': True, 'wet': False, 'x1': False}]","True"],["['p and not not q', {'p': False, 'q': True, 'rain': True, 'wet': False, 'x1': True}]","False"],["['p and not not q', {'p': True, 'q': False, 'rain': True, 'wet': True, 'x1': True}]","False"],["['false -> p and q', {'p': False, 'q': True, 'rain': False, 'wet': True, 'x1': False}]","True"],["['false -> p and q', {'p': True, 'q': True, 'rain': False, 'wet': True, 'x1': True}]","True"],["['p or q -> rain and wet', {'p': True, 'q': True, 'rain': True, 'wet': True, 'x1': True}]","True"],["['p or q -> rain and wet', {'p': False, 'q': True, 'rain': False, 'wet': False, 'x1': True}]","False"],["['((((true) -> wet) -> wet and p) -> ((rain -> true) or ((q) -> wet))) or not x1', {'p': True, 'q': False, 'rain': True, 'wet': False, 'x1': False}]","True"],["['(true or p) and (x1 -> false) or false and true or (((rain -> wet) -> (x1 -> x1)) -> ((true) -> rain) or (p or rain))', {'p': False, 'q': False, 'rain': False, 'wet': True, 'x1': True}]","False"],["['rain -> q and q or false and x1 -> true and p -> false or false', {'p': False, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['not false and (false or not(false -> true))', {'p': True, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","False"],["['rain', {'p': True, 'q': True, 'rain': True, 'wet': False, 'x1': True}]","True"],["['q -> rain -> q and (false or true)', {'p': True, 'q': False, 'rain': False, 'wet': False, 'x1': False}]","True"],["['rain', {'p': True, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['p', {'p': True, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['not((p and rain -> x1 -> p) -> (wet -> q or x1))', {'p': True, 'q': False, 'rain': True, 'wet': True, 'x1': True}]","False"],["['(rain and x1 or not wet -> (wet -> (true)) or q and p) -> ((rain -> x1) or (q)) and (wet and (q -> q))', {'p': False, 'q': True, 'rain': False, 'wet': True, 'x1': True}]","True"],["['wet -> (false -> (true) -> (q)) -> not q -> p or rain', {'p': False, 'q': False, 'rain': True, 'wet': True, 'x1': False}]","True"],["['(((p -> wet) -> not q) -> not(true -> wet)) or (((x1) -> true) -> rain or rain) and (not p -> p)', {'p': False, 'q': True, 'rain': True, 'wet': True, 'x1': False}]","True"],["['not not(false and (false -> (false)))', {'p': True, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","False"],["['((not true -> p -> wet) -> not p or false) and (((q -> (false)) -> rain or q) -> not(false -> p))', {'p': True, 'q': False, 'rain': False, 'wet': True, 'x1': True}]","False"],["['((p -> false) and (rain and wet or x1 and x1)) -> (q or p -> not p) -> p or rain -> not x1', {'p': False, 'q': False, 'rain': True, 'wet': True, 'x1': True}]","False"],["['not false', {'p': True, 'q': False, 'rain': False, 'wet': False, 'x1': True}]","True"],["['p -> ((p -> false) -> (false) -> (rain)) -> (true -> (true)) -> p', {'p': True, 'q': False, 'rain': True, 'wet': False, 'x1': False}]","True"],["['false', {'p': False, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","False"],["['(((rain and rain) -> x1 -> p) -> x1 and p -> not wet) -> not ((rain) and false) -> (not x1)', {'p': True, 'q': False, 'rain': False, 'wet': False, 'x1': True}]","False"],["['(false) and ((not true -> not q) -> not rain or (not true))', {'p': True, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","False"],["['(q -> rain) -> q', {'p': True, 'q': True, 'rain': False, 'wet': True, 'x1': False}]","True"],["['(p -> wet and false) or ((q -> wet) -> false) -> false or ((rain -> rain) or false)', {'p': True, 'q': False, 'rain': False, 'wet': True, 'x1': False}]","True"],["['(x1 or true or (p or q)) and q -> wet and ((rain) or q -> rain -> true)', {'p': True, 'q': False, 'rain': True, 'wet': False, 'x1': True}]","True"],["['p', {'p': False, 'q': False, 'rain': True, 'wet': True, 'x1': False}]","False"],["['((true -> x1) or (false -> (wet)) -> q) -> wet', {'p': False, 'q': False, 'rain': True, 'wet': False, 'x1': False}]","True"],["['((true or wet -> not false) -> rain and (true -> q)) and q', {'p': False, 'q': True, 'rain': False, 'wet': False, 'x1': False}]","False"],["['q', {'p': True, 'q': True, 'rain': False, 'wet': False, 'x1': True}]","True"],["['rain -> (q or x1 -> p -> (true)) -> p or (x1) -> not true', {'p': False, 'q': False, 'rain': True, 'wet': True, 'x1': True}]","False"]],"ref":"def truth(expr: str, env: dict) -> bool:\n    toks = expr.replace('(', ' ( ').replace(')', ' ) ').split()\n    pos = 0\n\n    def peek():\n        return toks[pos] if pos < len(toks) else None\n\n    def take():\n        nonlocal pos\n        pos += 1\n        return toks[pos - 1]\n\n    def imp():\n        left = disj()\n        if peek() == '->':\n            take()\n            right = imp()\n            return (not left) or right\n        return left\n\n    def disj():\n        v = conj()\n        while peek() == 'or':\n            take()\n            r = conj()\n            v = v or r\n        return v\n\n    def conj():\n        v = neg()\n        while peek() == 'and':\n            take()\n            r = neg()\n            v = v and r\n        return v\n\n    def neg():\n        if peek() == 'not':\n            take()\n            return not neg()\n        t = take()\n        if t == '(':\n            v = imp()\n            take()\n            return v\n        if t == 'true':\n            return True\n        if t == 'false':\n            return False\n        return bool(env[t])\n\n    return imp()\n"},{"id":"holdout/6","entry":"union_area","prompt":"def union_area(rects: list) -> int:\n    \"\"\"Each rectangle is [x1, y1, x2, y2] with integers x1 < x2 and y1 < y2 (any size, may be\n    negative). Return the total area covered by the union of all rectangles: overlapping parts\n    count once. An empty list gives 0.\n    >>> union_area([[0, 0, 2, 2], [1, 1, 3, 3]])\n    7\n    \"\"\"\n","atol":0,"cases":[["[[]]","0"],["[[[0, 0, 1, 1]]]","1"],["[[[0, 0, 2, 2], [0, 0, 2, 2]]]","4"],["[[[0, 0, 2, 2], [2, 0, 4, 2]]]","8"],["[[[-3, -3, 3, 3], [-1, -1, 1, 1]]]","36"],["[[[0, 0, 10, 1], [0, 0, 1, 10]]]","19"],["[[[-7, 14, -3, 17], [-3, -15, -1, -11], [-15, -11, -7, -10], [-10, 8, 0, 11], [6, 13, 8, 14], [4, -3, 6, 4], [-8, 2, 4, 12]]]","170"],["[[[-12, 15, -10, 19], [-6, 14, -1, 24], [-9, 1, 0, 5]]]","94"],["[[[-10, -2, -2, 0], [-3, 0, 2, 6], [-6, -15, -3, -8]]]","67"],["[[[2, -13, 10, -6], [12, 5, 17, 10]]]","81"],["[[[13, -9, 19, 0], [15, 7, 21, 14], [-1, -9, 5, -3], [-15, -13, -13, -10]]]","138"],["[[[-8, 14, 0, 19], [-10, 9, 1, 19], [-9, 8, -7, 20], [-3, 4, 9, 16]]]","230"],["[[[-8, 1, 0, 11], [-6, -7, 6, -5], [-2, 5, 7, 17]]]","200"],["[[[-2, -2, 7, 9], [11, -7, 19, 0], [-1, -11, 10, -5], [12, 7, 22, 9]]]","241"],["[[[-6, 14, 5, 18], [8, -2, 10, 9], [14, 0, 19, 11]]]","121"],["[[[13, 13, 19, 14]]]","6"],["[[[-9, -4, -3, 5], [4, 7, 12, 15], [-5, -8, 0, 2], [3, -4, 4, 0], [-7, -5, -4, -2], [-7, 3, 3, 11], [-15, -7, -14, 2]]]","243"],["[[[1, -3, 11, 0], [-7, -7, 0, 2], [6, -15, 11, -4], [-12, 14, -3, 21]]]","211"],["[[[1, 12, 3, 13], [8, 7, 12, 12], [-3, 10, 6, 19], [-5, -9, 1, 3]]]","173"],["[[[10, 3, 22, 13], [1, 8, 6, 9], [-3, 14, 1, 24], [4, 12, 7, 23], [14, 0, 19, 9]]]","213"],["[[[6, 4, 8, 15]]]","22"],["[[[-9, -5, -5, 5], [3, 0, 8, 8], [15, -10, 19, 2], [1, -4, 13, 1], [9, -12, 17, -1], [-14, 15, -4, 19]]]","281"],["[[[-9, 2, 2, 8], [8, 5, 10, 16]]]","88"],["[[[8, 9, 14, 17], [1, 0, 11, 5], [-10, 12, -2, 24]]]","194"],["[[[2, -4, 8, 2], [14, 9, 24, 13], [15, 8, 27, 13], [-14, 10, -3, 19], [-10, -6, -6, 1]]]","227"],["[[[7, -10, 19, -3], [-5, -10, 5, -6]]]","124"],["[[[6, 5, 7, 10], [4, -12, 14, -7], [4, 4, 15, 10], [-2, 9, 9, 19], [-8, 3, -2, 15]]]","293"],["[[[11, 0, 18, 12], [-9, 8, -2, 14], [-10, 8, -5, 11], [9, -6, 12, 0], [12, 6, 14, 15], [-8, -11, -4, -10]]]","157"],["[[[2, -13, 9, -10], [-3, 12, 5, 21]]]","93"],["[[[6, -14, 10, -8], [-5, 9, 5, 20], [6, 6, 17, 8]]]","156"],["[[[13, 3, 19, 10], [12, -7, 18, 3], [10, -5, 19, 4], [13, -4, 15, -3], [1, -8, 13, -4]]]","172"],["[[[14, 4, 15, 6], [-8, 0, -6, 5], [11, 1, 12, 4], [-11, -2, 0, 0], [-7, 15, 3, 25]]]","137"],["[[[-10, 13, -6, 18], [2, 13, 3, 22], [-10, 7, 2, 18]]]","141"],["[[[-1, 13, 10, 22], [-4, -9, 2, -4], [1, 0, 12, 5], [13, -6, 21, -2], [1, -10, 5, -4], [0, -6, 1, -4], [2, -1, 8, 8]]]","259"],["[[[0, 0, 1000000, 1000000], [500000, 500000, 2000000, 2000000]]]","3000000000000"]],"ref":"def union_area(rects: list) -> int:\n    xs = sorted({r[0] for r in rects} | {r[2] for r in rects})\n    total = 0\n    for i in range(len(xs) - 1):\n        a, b = xs[i], xs[i + 1]\n        spans = sorted((r[1], r[3]) for r in rects if r[0] <= a and r[2] >= b)\n        covered, end = 0, None\n        for y1, y2 in spans:\n            if end is None or y1 > end:\n                covered += y2 - y1\n                end = y2\n            elif y2 > end:\n                covered += y2 - end\n                end = y2\n        total += covered * (b - a)\n    return total\n"}]}