{pattern[pos]}\n                pos += 1\n            cur = {a + b for a in cur for b in inner}\n        return cur\n\n    return sorted(alt())\n"},{"id":"holdout/3","entry":"fewest_coins","prompt":"def fewest_coins(amount: int, coins: list, limit: int) -> int:\n    \"\"\"coins holds distinct positive denominations. You may use each denomination AT MOST limit\n    times. Return the fewest coins whose values add up to exactly amount, or -1 if that is\n    impossible. amount 0 needs 0 coins.\n    >>> fewest_coins(13, [5, 1], 2)\n    -1\n    >>> fewest_coins(10, [6, 4, 1], 1)\n    2\n    \"\"\"\n","atol":0,"cases":[["[0, [1, 2], 1]","0"],["[0, [], 3]","0"],["[7, [], 2]","-1"],["[3, [2], 5]","-1"],["[12, [5, 1], 2]","4"],["[24, [7, 5, 3], 2]","4"],["[6, [4, 3, 1], 3]","2"],["[100, [50, 25, 10, 1], 1]","-1"],["[63, [25, 21, 10, 1], 3]","3"],["[58, [23, 24, 5, 28], 2]","4"],["[161, [27, 14, 25, 4], 4]","7"],["[39, [22, 8], 2]","-1"],["[30, [12, 28, 29, 18, 6], 2]","2"],["[15, [21, 3, 5], 1]","-1"],["[38, [1, 8, 26], 2]","-1"],["[1, [3], 1]","-1"],["[119, [18, 13, 20], 3]","-1"],["[95, [23, 28, 16], 2]","4"],["[41, [18, 28, 2], 3]","-1"],["[19, [26], 1]","-1"],["[56, [28, 4], 4]","2"],["[122, [13, 19], 4]","-1"],["[110, [8, 25, 29], 2]","-1"],["[12, [29], 1]","-1"],["[12, [24, 10, 22, 18], 1]","-1"],["[89, [16, 12, 8, 14, 27], 3]","4"],["[21, [18, 17, 26, 28, 27], 4]","-1"],["[54, [4, 18, 9], 2]","4"],["[139, [29, 9, 21], 4]","7"],["[30, [2, 12], 3]","5"],["[5, [9], 4]","-1"],["[125, [23, 24, 25], 2]","-1"],["[104, [29, 27, 19, 2, 15], 2]","4"],["[22, [8, 3], 4]","4"],["[14, [19, 20], 3]","-1"],["[78, [25, 2], 4]","-1"]],"ref":"def fewest_coins(amount: int, coins: list, limit: int) -> int:\n    INF = float('inf')\n    best = [0] + [INF] * amount\n    for c in coins:\n        nxt = best[:]\n        for total in range(amount + 1):\n            if best[total] == INF:\n                continue\n            for n in range(1, limit + 1):\n                t = total + n * c\n                if t > amount:\n                    break\n                if best[total] + n < nxt[t]:\n                    nxt[t] = best[total] + n\n        best = nxt\n    return -1 if best[amount] == INF else best[amount]\n"},{"id":"holdout/4","entry":"first_slot","prompt":"def first_slot(busy: list, day_start: str, day_end: str, minutes: int):\n    \"\"\"busy has one list per person; each list holds that person's busy times as 'HH:MM-HH:MM'\n    strings (24-hour clock, start before end, same day), possibly overlapping and in any order.\n    Return the earliest start time 'HH:MM' of a meeting lasting `minutes` that lies fully inside\n    day_start..day_end and overlaps nobody's busy time, or None if there is no such time.\n    A meeting may start exactly when a busy time ends and may end exactly when one starts.\n    >>> first_slot([['09:00-10:00'], ['09:30-10:30']], '09:00', '12:00', 30)\n    '10:30'\n    >>> first_slot([['09:00-11:50']], '09:00', '12:00', 15)\n    None\n    \"\"\"\n","atol":0,"cases":[["[[], '09:00', '10:00', 60]","'09:00'"],["[[], '09:00', '10:00', 61]","None"],["[[[]], '08:00', '08:30', 15]","'08:00'"],["[[['09:00-10:00'], ['10:00-11:00']], '09:00', '12:00', 60]","'11:00'"],["[[['08:00-09:30']], '09:00', '17:00', 30]","'09:30'"],["[[['12:00-13:00']], '09:00', '17:00', 180]","'09:00'"],["[[['09:05-09:10', '09:00-09:20']], '09:00', '09:40', 20]","'09:20'"],["[[['08:10-10:30', '08:25-10:40', '09:05-09:45'], ['11:10-12:40', '09:15-10:10']], '09:10', '10:55', 120]","None"],["[[[], [], ['09:30-10:15', '11:05-11:30']], '08:05', '14:15', 30]","'08:05'"],["[[['10:10-11:50'], ['10:15-10:25', '10:45-10:55', '11:05-11:40', '11:25-12:35']], '10:10', '11:25', 15]","None"],["[[['10:50-12:00', '08:40-10:30'], ['11:10-11:40', '08:35-10:45', '10:15-10:35', '11:10-12:20']], '09:10', '10:45', 60]","None"],["[[['08:20-09:40', '09:40-10:55'], ['07:55-09:30', '08:30-10:55'], ['07:15-09:10', '09:00-10:05'], ['09:25-11:35', '06:20-08:20', '06:50-08:55']], '06:30', '09:20